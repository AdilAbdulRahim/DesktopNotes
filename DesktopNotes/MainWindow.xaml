<Window x:Class="DesktopNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopNotes"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowState="Normal"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Background="Transparent">
        <Canvas x:Name="NotesCanvas"
            Background="#03FFFFFF"
            Focusable="True"
            IsHitTestVisible="True"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <Canvas.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New bullet note" Click="BulletButton_Click"/>
                    <MenuItem Header="New numbered note" Click="NumberButton_Click"/>
                    <Separator/>
                    <MenuItem Header="Background: Ice Blue" Tag="#CCEBF4FF" Click="ColorButton_Click"/>
                    <MenuItem Header="Background: Soft Mint" Tag="#CCF0FFF0" Click="ColorButton_Click"/>
                    <MenuItem Header="Background: Warm Blush" Tag="#CCFFF1F7" Click="ColorButton_Click"/>
                </ContextMenu>
            </Canvas.ContextMenu>
        </Canvas>
        
        <!-- InkCanvas for drawing on wallpaper (visible but non-hit-testable by default so strokes persist) -->
        <InkCanvas x:Name="DrawCanvas"
               Visibility="Visible"
               Background="Transparent"
               IsHitTestVisible="False"
               EditingMode="Ink"
               Cursor="Cross"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Margin="0" />

        <!-- Tool stack (pencil + reset + transparency) -->
        <StackPanel x:Name="ToolPanel"
                    Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Focusable="False">
            <!-- Glass-like pencil button -->
            <Button x:Name="PencilButton"
                    Width="48"
                    Height="48"
                    Click="PencilButton_Click"
                    ToolTip="Toggle draw mode"
                    Style="{StaticResource ToolbarButtonStyle}"
                    FocusVisualStyle="{x:Null}"
                    Margin="0,0,0,8">
                <Border Width="48" Height="48" CornerRadius="24" BorderThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#66FFFFFF" Offset="0"/>
                            <GradientStop Color="#22FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock x:Name="PencilIcon" Text="✎" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>

            <!-- Undo action button -->
            <Button x:Name="UndoButton"
                    Width="40"
                    Height="40"
                    Click="UndoButton_Click"
                    ToolTip="Undo last action"
                    Style="{StaticResource ToolbarButtonStyle}"
                    FocusVisualStyle="{x:Null}"
                    Margin="0,0,0,8">
                <Border Width="40" Height="40" CornerRadius="20" BorderThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                            <GradientStop Color="#11000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="↩" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>
            <!-- Redo action button -->
            <Button x:Name="RedoButton"
                    Width="40"
                    Height="40"
                    Click="RedoButton_Click"
                    ToolTip="Redo last undone action"
                    Style="{StaticResource ToolbarButtonStyle}"
                    FocusVisualStyle="{x:Null}"
                    Margin="0,0,0,8">
                <Border Width="40" Height="40" CornerRadius="20" BorderThickness="0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                            <GradientStop Color="#11000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="↪" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Button>
        </StackPanel>

        <TextBlock x:Name="PromptTextBlock"
                   Text="Click anywhere to start typing"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="24"
                   Foreground="White"
                   Opacity="0.75"
                   FontSize="15"
                   FontFamily="Segoe UI Variable Text"
                   FontWeight="SemiBold"
                   FontStyle="Normal" />
    </Grid>
</Window>
